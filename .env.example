GRAPHQL_URL=http://localhost:4000
# Obrigatório e não pode ficar vazio: sem ele o servidor (next start / next dev) não sobe
# Deve ser igual ao JWT_SECRET da API (o token é assinado lá e verificado aqui)
JWT_SECRET=
# Fuso horário (IANA) para exibir datas; padrão: America/Sao_Paulo
APP_TIME_ZONE=America/Sao_Paulo
